# Solana RPC used by the server routes (never sent to the browser)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# The solver, reached from the server only (e.g. https://api.example.com, or http://127.0.0.1:3197 through a tunnel)
SOLVER_URL=
# Owner of the standard exit's wXMR fee account. The fee is only charged once that account exists.
FEE_OWNER=
# Optional: a Jupiter API key and URL
JUP_API_KEY=
JUP_API_URL=
# Public site settings
NEXT_PUBLIC_SITE_URL=https://www.neroswap.app
NEXT_PUBLIC_SITE_DOMAIN=neroswap.app
NEXT_PUBLIC_GITHUB_URL=https://github.com/minseochoj/nero
NEXT_PUBLIC_X_HANDLE=
# Set at build time to the commit being deployed (deploy/deploy-site.sh does this)
NEXT_PUBLIC_COMMIT=dev
