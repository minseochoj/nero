# Solana RPC (a paid endpoint: the watcher reads the deposit wallet every 4 seconds)
RPC_URL=https://api.mainnet-beta.solana.com
SOLVER_PORT=3197
SOLVER_DATA=/opt/nero/data/

# Keys: append the secrets.env that scripts/new-keys.mjs wrote
# SOLVER_KEY_FILE=  SOLVER_BOX_SECRET=  SOLVER_ADDR_SEED=  SOLVER_ADMIN_SECRET=

# Monero: our own node, and the wallet service in front of it (both on 127.0.0.1 only)
DAEMON_URL=http://127.0.0.1:18081
WALLET_RPC_URL=http://127.0.0.1:18093/json_rpc
WALLET_FILE=nero
WALLET_PASS=

# Switches. Quotes stay off until SOLVER_ENABLED=1. PAYOUTS_ENABLED=0 stops every send.
SOLVER_ENABLED=0
PAYOUTS_ENABLED=1
REBALANCE_LIVE=0
XCHAIN_ENABLED=0

# Pricing and limits (piconero: 1 XMR = 1000000000000)
SPREAD_BPS=60
MIN_XMR_PICO=10000000000
MAX_ORDER_PICO=500000000000
DAILY_CAP_PICO=10000000000000
